# Runtime stage and feature gates
# The main Sessions product is the real registry/booking/provider system. The demo is an optional owner-only sandbox.
SESSIONS_APP_MODE=production
SESSIONS_DEMO_ENABLED=true
SESSIONS_DEMO_AUTH_ENABLED=true
SESSIONS_DEMO_OWNER_EMAILS=

# Identity mode: use chatgpt only for the private Sites preview; production should switch to supabase after live provider tests.
SESSIONS_IDENTITY_MODE=chatgpt

# Private Sites-preview authority lists. Production role assignments live in Supabase platform_role_assignments.
# These lists exist only so the private preview can exercise permission boundaries before the live Sessions Supabase project is certified.
SESSIONS_SUPER_ADMIN_EMAILS=
SESSIONS_SUPER_ADMIN_ELIGIBLE_EMAILS=
SESSIONS_CORPORATE_ADMIN_EMAILS=
SESSIONS_OPERATIONS_EMAILS=
SESSIONS_FINANCE_EMAILS=
SESSIONS_FINANCE_MANAGER_EMAILS=
SESSIONS_TRUST_SAFETY_EMAILS=
SESSIONS_TRUST_SAFETY_MANAGER_EMAILS=
SESSIONS_SUPPORT_EMAILS=
SESSIONS_SUPPORT_MANAGER_EMAILS=
SESSIONS_PROVIDER_OPERATIONS_EMAILS=
SESSIONS_PROVIDER_OPERATIONS_MANAGER_EMAILS=
SESSIONS_GROWTH_ANALYST_EMAILS=
SESSIONS_GROWTH_MANAGER_EMAILS=
SESSIONS_DATA_ANALYST_EMAILS=
SESSIONS_DATA_ADMIN_EMAILS=
SESSIONS_PRODUCT_OPERATIONS_EMAILS=
SESSIONS_GOVERNANCE_REVIEWER_EMAILS=
# Legacy preview fallback; configured addresses are treated as legacy super administrators.
SESSIONS_ADMIN_EMAILS=

# Phase R feature flags (all off until their integration gates pass)
PAYMENTS_GATEWAY_ENABLED=false
EMAIL_PROVIDER_ENABLED=false
EMAIL_PROVIDER_ENDPOINT=
EMAIL_PROVIDER_TOKEN=
EMAIL_FROM=
AI_SEARCH_ENABLED=false
ZIG_ENABLED=false

# Production identity
SUPABASE_AUTH_ENABLED=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_PHONE_AUTH_ENABLED=false
SUPABASE_GOOGLE_AUTH_ENABLED=false
SUPABASE_CAPTCHA_PROVIDER=
SUPABASE_CAPTCHA_SITE_KEY=

# Optional AI requirement extraction
OPENAI_API_KEY=
OPENAI_MODEL=

# Platform calendar
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_NAME=Sessions Music Bookings
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Platform subscription gates
BILLING_ENABLED=false
BILLING_MODE=test
BILLING_AMOUNT_CENTS=
BILLING_ORIGIN=
BILLING_MERCHANT_NAME=
BILLING_SUPPORT_EMAIL=
BILLING_WEBHOOK_READY=false
BILLING_LIVE_APPROVED=false

# Stripe subscription adapter
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# PayPal subscription adapter
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PLAN_ID=
PAYPAL_WEBHOOK_ID=

# Paynow subscription adapter
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
PAYNOW_CURRENCY=USD
PAYNOW_MODE=test
