{
  "expo": {
    "name": "Sessions UAT",
    "slug": "sessions-native-uat",
    "scheme": "sessions-uat",
    "version": "0.5.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "ios": {
      "bundleIdentifier": "com.sessionstech.sessions.uat",
      "supportsTablet": true
    },
    "android": {
      "package": "com.sessionstech.sessions.uat",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "extra": {
      "sessionsPhase": 5,
      "sessionsReleaseId": "unified-platform-v1-phase5",
      "sessionsVisualRevision": "phase1-5-native-desktop-v2",
      "sessionsUatOrigin": "https://sessions-music.kudzimusar.chatgpt.site"
    }
  }
}
